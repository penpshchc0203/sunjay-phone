{
  "dialogues": [
    {
      "id": "demo-incoming-sunwoo",
      "eventId": "test-phone",
      "contactId": "sunwoo",
      "title": "선우에게 걸려온 전화",
      "lines": [
        {
          "from": "me",
          "text": "여보세요?"
        },
        {
          "from": "other",
          "text": "응 형! 전화해 달라며? 무슨 일 있어?"
        },
        {
          "from": "me",
          "text": "어, 선우. 진짜 바로 전화했네."
        },
        {
          "from": "other",
          "text": "마침 폰 보구 있었어! 왜?"
        },
        {
          "from": "me",
          "text": "아니, 그냥 목소리 듣고 싶어서."
        },
        {
          "from": "other",
          "text": "아 뭐야! 무슨 일 생긴줄 알고 깜짝 놀랬네!"
        },
        {
          "from": "me",
          "text": "미안미안. 뭐 하고 있었어?"
        },
        {
          "from": "other",
          "text": "과제하다가 잠깐 쉬구 있어. 형은?"
        },
        {
          "from": "me",
          "text": "나도 좀 쉬는 중. 짬나서 전화 했어. 잠깐 통화해도 돼?"
        },
        {
          "from": "other",
          "text": "웅! 되지."
        }
      ]
    },
    {
      "id": "outgoing-call-sunwoo",
      "contactId": "sunwoo",
      "title": "종성이가 선우에게 건 전화",
      "lines": [
        {
          "from": "other",
          "text": "여보세요? 형!"
        },
        {
          "from": "me",
          "text": "어, 선우야. 지금 통화 괜찮아?"
        },
        {
          "from": "other",
          "text": "응! 무슨 일이야?"
        },
        {
          "from": "me",
          "text": "그냥 목소리 듣고 싶어서 전화했어."
        },
        {
          "from": "other",
          "text": "(웃음) 아아, 뭐야. 나도 형 생각하고 있었는데."
        },
        {
          "from": "me",
          "text": "진짜? 뭐 하고 있었어?"
        },
        {
          "from": "other",
          "text": "나 집에서 쉬고 있었어. 형은?"
        },
        {
          "from": "me",
          "text": "나도 이제 좀 쉬려고."
        },
        {
          "from": "other",
          "text": "그럼 좀 더 통화하자 ㅎㅎ"
        }
      ],
      "timeRanges": {
        "morning": {
          "start": "08:00",
          "end": "11:59"
        },
