    {
      "id": "outgoing-call-sunwoo:morning",
      "contactId": "sunwoo",
      "title": "월요일 오전",
      "lines": [
        {
          "from": "other",
          "text": "어? 여보세요?"
        },
        {
          "from": "me",
          "text": "여보세요? 선우?"
        },
        {
          "from": "other",
          "text": "응! 뭐야? 왜 갑자기 전화했어?"
        },
        {
          "from": "me",
          "text": "으응? 전화하면 안돼?"
        },
        {
          "from": "other",
          "text": "아니아니, 그게 아니라. 갑자기 전화와서 놀라갖구!"
        },
        {
          "from": "me",
          "text": "잠깐 시간 나서 전화했어. 학교야?"
        },
        {
          "from": "other",
          "text": "아직! 지금 강의실 가는 중. 형은 회사야?"
        },
        {
          "from": "me",
          "text": "응. 곧 회의 들어가야 돼."
        },
        {
          "from": "other",
          "text": "아아, 월요일부터 바쁘네."
        },
        {
          "from": "me",
          "text": "그러게. 너는 오늘 수업 몇 시까지야?"
        },
        {
          "from": "other",
          "text": "오후까지 있어. 끝나면 과제도 좀 해야 되구."
        },
        {
          "from": "me",
          "text": "아이고. 엄청 바쁘네. 점심 꼭 챙겨 먹고."
        },
        {
          "from": "other",
          "text": "형도! 나 강의실 들어간다. 카톡할게!"
        },
        {
          "from": "me",
          "text": "어잉, 수업 잘 듣고!"
        }
      ]
    },
    {
      "id": "outgoing-call-sunwoo:lunch",
      "contactId": "sunwoo",
      "title": "월요일 점심",
      "lines": [
        {
          "from": "other",
          "text": "여보세요?"
        },
        {
          "from": "me",
          "text": "어 선우, 점심 먹었어?"
        },
        {
          "from": "other",
          "text": "응! 학식 먹었어. 형은?"
        },
        {
          "from": "me",
          "text": "나도 먹었지. 밥 먹고 잠깐 걷는 중. 학식 뭐 나왔어?"
        },
        {
          "from": "other",
          "text": "오늘 돈가스!"
        },
        {
          "from": "me",
          "text": "오, 맛있었어?"
        },
        {
          "from": "other",
          "text": "응, 근데 소스가 너무 적었어(웃음)."
        },
        {
          "from": "me",
          "text": "(웃음) 다음엔 소스 더 달라고 해."
        },
        {
          "from": "other",
          "text": "형은 뭐 먹었는데?"
        },
        {
          "from": "me",
          "text": "난 회사 사람들일아 국밥 먹었어."
        },
        {
          "from": "other",
          "text": "헐. 든든하겠다. 나도 국밥 먹고 싶어! 형이랑 먹었던 거기 맛있었는데."
        },
        {
          "from": "me",
          "text": "다음에 또 가자. 이제 수업 가야 하지?"
        },
        {
          "from": "other",
          "text": "응! 형도 오후에 힘내!"
        },
        {
          "from": "me",
          "text": "응, 선우도! 연락할게!"
        },
        {
          "from": "other",
          "text": "으응~"
        }
      ]
    },
    {
      "id": "outgoing-call-sunwoo:afternoon",
      "contactId": "sunwoo",
      "title": "월요일 오후",
      "lines": [
        {
          "from": "other",
          "text": "여보세요? 형?"
        },
        {
          "from": "me",
          "text": "어 선우. 잠깐 통화 괜찮아?"
        },
        {
          "from": "other",
          "text": "응응! 방금 수업 끝났어. 형은?"
        },
        {
          "from": "me",
          "text": "나도 회의 끝나서 잠깐 쉬는 중."
        },
        {
          "from": "other",
          "text": "힘들겠다."
        },
        {
          "from": "me",
          "text": "익숙해져서 괜찮아~ 오늘 수업은 어땠어?"
        },
        {
          "from": "other",
          "text": "나.... 교수님이 과제 하나 더 내줬어. 허엉...."
        },
        {
          "from": "me",
          "text": "아이고, 이번 주도 바쁘겠네."
        },
        {
          "from": "other",
          "text": "그러니깐! 형 몇 시에 퇴근해?"
        },
        {
          "from": "me",
          "text": "나 오늘 일찍 출근해서 퇴근도 빨리 할걸? 별 일 없으면."
        },
        {
          "from": "other",
          "text": "오오!"
        },
        {
          "from": "me",
          "text": "끝나면 카톡할게."
        },
        {
          "from": "other",
          "text": "응! 나도 과제 좀 하다 카톡할게!"
        },
        {
          "from": "me",
          "text": "그래, 이따 연락해!"
        }
      ]
    },
    {
      "id": "outgoing-call-sunwoo:evening",
      "contactId": "sunwoo",
      "title": "월요일 퇴근 무렵",
      "lines": [
        {
          "from": "other",
          "text": "여보세요? 형?"
        },
        {
          "from": "me",
          "text": "응 선우야. 뭐해?"
        },
        {
          "from": "other",
          "text": "나 집에서 뒹굴거리는 중! 형 퇴근했어?"
        },
        {
          "from": "me",
          "text": "부럽다. 나 방금 퇴근했지. 지하철 타러 가는 중."
        },
        {
          "from": "other",
          "text": "월요일 피곤하지?"
        },
        {
          "from": "me",
          "text": "응. 근데 목소리 들으니까 좀 낫다."
        },
        {
          "from": "other",
          "text": "에에~ 뭐야 갑자기! (큰웃음)"
        },
        {
          "from": "me",
          "text": "왜, 진짠데."
        },
        {
          "from": "other",
          "text": "으이구. 얼른 만나야겠네."
        },
        {
          "from": "me",
          "text": "그래야지. 저녁 먹었어?"
        },
        {
          "from": "other",
          "text": "아직. 이제 먹으려구!"
        },
        {
          "from": "me",
          "text": "얼른 챙겨 먹어. 집 가서 카톡할게"
        },
        {
          "from": "other",
          "text": "응 조심히 가!"
        },
        {
          "from": "me",
          "text": "어잉."
        }
      ]
    },
    {
      "id": "outgoing-call-sunwoo:night",
      "contactId": "sunwoo",
      "title": "월요일 밤",
      "lines": [
        {
          "from": "other",
          "text": "응 형!"
        },
        {
          "from": "me",
          "text": "어 선우. 뭐하고 있었어?"
        },
        {
          "from": "other",
          "text": "나 씻고 누웠어. 형은?"
        },
        {
          "from": "me",
          "text": "나도 이제 눕는다. 으아아아! 월요일 드디어 끝이다!"
        },
        {
          "from": "other",
          "text": "고생했어. 오늘 많이 바빴어?"
        },
        {
          "from": "me",
          "text": "응. 오전부터 회의 있어서 정신 없었지."
        },
        {
          "from": "other",
          "text": "아이구. 내일은 좀 덜 바빴으면 좋겠다."
        },
        {
          "from": "me",
          "text": "그러게. 선우는? 과제 다했어?"
        },
        {
          "from": "other",
          "text": "음... 아니? 그냥 내일의 나한테 맡길라구."
        },
        {
          "from": "me",
          "text": "아이고 내일의 선우 어쩌냐(웃음). 고생하겠네."
        },
        {
          "from": "other",
          "text": "형이 응원 많이 해줘."
        },
        {
          "from": "me",
          "text": "그래. 응원해 줄게. 내일도 파이팅!"
        },
        {
          "from": "other",
          "text": "(웃음) 바보. 형 이제 잘거야?"
        },
        {
          "from": "me",
          "text": "음, 조금 있다가?"
        },
        {
          "from": "other",
          "text": "나는 피곤해서 오늘 일찍 잘라구."
        },
        {
          "from": "me",
          "text": "알겠어. 선우 잘 자고. 내일 일어나면 연락해."
        },
        {
          "from": "other",
          "text": "알겠어! 형 잘 자!"
        },
        {
          "from": "me",
          "text": "응 잘 자~"
        }
      ]
    },
